# Public browser configuration. Publishable keys are expected in frontend code.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-dev-publishable-key
VITE_APP_ENV=local

# Server-only values belong in supabase/functions/.env or the Supabase secret store.
# Never prefix secret/service-role values with VITE_.
